# Use a direct connection or SESSION pooler (5432); NEVER transaction pooler (6543).
# PostgreSQL is mandatory for monitoring. SQLite is used only by isolated unit tests.
DATABASE_URL=postgresql+psycopg://sentinela:PASSWORD@HOST:5432/postgres?sslmode=require
TEST_DATABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
# Optional semantic extraction, DISABLED by default. Explicit opt-in can incur costs.
LLM_BASE_URL=
LLM_API_KEY=
GITHUB_TOKEN=
GITHUB_REPOSITORY=
BACKUP_ENCRYPTION_KEY=
WATCHDOG_PING_URL=
